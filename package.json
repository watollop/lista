{
  "name": "lista",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm run build && set -a && . ./.env.cloudflare && set +a && npx --yes wrangler pages deploy dist --project-name lista --branch main --commit-dirty=true"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "dexie": "^4.4.7",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
